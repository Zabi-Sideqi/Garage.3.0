@using GarageV3.Helpers

@model GarageV3.ViewModels.Parking.ReceiptViewModel

@{
    ViewData["Title"] = "Garage Receipt";
}

<style>
    @@media print {
        nav,
        header,
        footer,
        .navbar,
        .navbar-brand,
        .d-print-none {
            display: none !important;
        }

        body {
            background: white !important;
            margin: 0 !important;
        }

        main {
            padding: 0 !important;
            margin: 0 !important;
        }

        .container {
            max-width: 100% !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .receipt-page-title {
            margin-top: 0 !important;
        }

        .receipt-card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }
    }
</style>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successAlert" class="alert alert-success d-print-none">
        @TempData["SuccessMessage"]
    </div>
}

<h1 class="mb-4 receipt-page-title">Garage Receipt</h1>

<div class="card shadow-lg receipt-card">

    <div class="card-header bg-dark text-white">
        <h3 class="mb-0">Receipt</h3>
    </div>

    <div class="card-body">

        <p class="text-muted mb-4">
            Thank you for using our garage services!
        </p>

        <h5 class="mb-3">Vehicle Information</h5>

        <table class="table table-bordered table-striped">
            <tbody>

                <tr>
                    <th>Owner Email</th>
                    <td>@Model.OwnerEmail</td>
                </tr>

                <tr>
                    <th style="width:35%">Registration Number</th>
                    <td>@Model.RegistrationNumber</td>
                </tr>

                <tr>
                    <th>Vehicle Type</th>
                    <td>@Model.VehicleTypeName</td>
                </tr>

                <tr>
                    <th>Brand</th>
                    <td>@Model.Brand</td>
                </tr>

                <tr>
                    <th>Model</th>
                    <td>@Model.Model</td>
                </tr>

                <tr>
                    <th>Color</th>
                    <td>@Model.Color</td>
                </tr>

                <tr>
                    <th>Number of Wheels</th>
                    <td>@Model.NumberOfWheels</td>
                </tr>

            </tbody>
        </table>

        <h5 class="mt-4 mb-3">Parking Information</h5>

        <table class="table table-bordered table-striped">
            <tbody>

                <tr>
                    <th style="width:35%">Arrival Time</th>
                    <td class="local-time-display"
                        data-utc='@Model.ArrivalTime.ToString("o")'>
                        @Model.ArrivalTime.ToString("yyyy-MM-dd HH:mm") UTC
                    </td>
                </tr>

                <tr>
                    <th>Check Out Time</th>
                    <td class="local-time-display"
                        data-utc='@Model.CheckOutTime.ToString("o")'>
                        @Model.CheckOutTime.ToString("yyyy-MM-dd HH:mm") UTC
                    </td>
                </tr>

                <tr>
                    <th>Parking Duration</th>
                    <td>
                        @Model.ParkingDuration.Days day(s)
                        @Model.ParkingDuration.Hours h
                        @Model.ParkingDuration.Minutes min
                    </td>
                </tr>

                <tr>
                    <th>Parking Spot</th>
                    <td>
                        @SpotHelper.GetSpotDisplay(
                            Model.ParkingSpotId,
                            Model.VehicleTypeName)
                    </td>
                </tr>

                <tr>
                    <th>Hourly Rate At Check In</th>
                    <td>
                        @Model.HourlyRateAtCheckIn.ToString("0.00") SEK
                    </td>
                </tr>

                <tr>
                    <th>Applied Discount</th>
                    <td>
                        @if (Model.AppliedDiscountPercentage > 0)
                        {
                            <strong class="text-danger">
                                Pro-discount
                                (-@((Model.AppliedDiscountPercentage * 100).ToString("0"))%)
                            </strong>
                        }
                        else
                        {
                            <strong class="text-success">
                                Ingen rabatt
                            </strong>
                        }
                    </td>
                </tr>

                <tr class="table-success">
                    <th>Parking Fee</th>
                    <td class="fw-bold">
                        @Model.TotalPrice.ToString("0.00") SEK
                    </td>
                </tr>

            </tbody>
        </table>

    </div>

    <div class="card-footer d-flex justify-content-between">

        <small class="text-muted">
            Thank you for visiting Garage 3.0
        </small>

        <div class="d-flex gap-2 d-print-none">

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="window.print()">
                Print Receipt
            </button>

            <a asp-action="History"
               class="btn sv-btn-create">
                Back to My History
            </a>

        </div>

    </div>

</div>

@section Scripts {
    <script>
        fadeOutSuccessAlert();
    </script>
}